{
  "name": "bbs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc && vite build",
    "check-types": "tsc",
    "dev": "vite",
    "format:js": "eslint --fix src",
    "format:styles": "prettier --write \"src/**/*.css\"",
    "generate": "node scripts/generate-types.mjs",
    "lint:js": "eslint src",
    "lint:styles": "prettier --check \"src/**/*.css\"",
    "preview": "vite preview",
    "start": "vite",
    "test": "node --test"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@nivo/bar": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "clsx": "^1.1.1",
    "date-fns": "^2.28.0",
    "graphql": "^16.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.30.0",
    "react-router-dom": "^7.18.4",
    "use-url-search-params": "^2.5.1"
  },
  "devDependencies": {
    "@graphql-codegen/core": "^6.2.2",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-typed-document-node/core": "^3.1.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.29.4",
    "eslint-plugin-react-hooks": "^4.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-svgr": "^5.2.0",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": "20"
  },
  "overrides": {
    "@whatwg-node/promise-helpers": "^1.3.2"
  }
